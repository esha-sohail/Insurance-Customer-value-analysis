--ROW_NUMBER()
--Assign row numbers to customers by CLV.

SELECT customer,
       customer_lifetime_value,
       ROW_NUMBER() OVER (
           ORDER BY customer_lifetime_value DESC
       ) AS row_num
FROM customer_insurance;

--Assign row numbers within each state.
select customer,state,customer_lifetime_value,
 row_number() over(partition by state 
 order by customer_lifetime_value desc) as row_num
 from customer_insurance
 order by state,row_num;


 --Find the top 5 customers in every state.
 WITH ranked_customers AS (
    SELECT customer,
           state,
           customer_lifetime_value,
           ROW_NUMBER() OVER (
               PARTITION BY state
               ORDER BY customer_lifetime_value DESC
           ) AS row_num
    FROM customer_insurance
)

SELECT customer,
       state,
       customer_lifetime_value,
       row_num
FROM ranked_customers
WHERE row_num <= 5
ORDER BY state, row_num;


--Find the highest-income customer in every state.
with ranked_customer as
( select state,customer,income,
      row_number()over(partition by state 
	  order by income desc) as row_num
	  from customer_insurance 
	  )
	select customer,
	state,row_num
	from ranked_customer
	where row_num =1
	order by state,row_num;




--rank()
--Rank customers by Customer Lifetime Value.
select customer,
customer_lifetime_value,
rank() 
over(order by customer_lifetime_value desc) as rank_num
from customer_insurance;

--Rank customers by income.
select customer,
income,
rank() 
over(order by income desc) as rank_num
from customer_insurance;

--Rank states by average CLV.

with state_clv as (
select state,
avg(customer_lifetime_value) as avg_clv
from customer_insurance
group by state
        )
  select state,
  avg_clv,
  rank() over(order by avg_clv desc) as state_rank
  from state_clv
  order by state_rank;


--Rank policy types by premium revenue
with policy_rank as (
select policy_type,
sum(monthly_premium_auto) as total_premium_revnue
from customer_insurance
group by policy_type
        )
  select policy_type,
 total_premium_revnue,
  rank() over(order by total_premium_revnue desc) as policy_type_rank
  from policy_rank
  order by policy_type_rank;


--DENSE_RANK()
--Dense rank customers based on claim amount.
select 
customer,total_claim_amount,
dense_rank() over(order by total_claim_amount desc)
as claim_rank
from customer_insurance;

--Dense rank vehicle classes by average premium.
with vehicle_rank as
(
select vehicle_class,
avg(monthly_premium_auto)
as avg_premium
from customer_insurance
group by vehicle_class
  )
  select vehicle_class, avg_premium,
  dense_rank() over(order by avg_premium desc ) as ranking
  from vehicle_rank
  order by ranking;


 --Dense rank states by average income.
 with state_rank as(
select state,
round(avg(income),2) as avg_income
from customer_insurance
group by state
 )
 select state,avg_income,
 dense_rank()over(order by avg_income desc) as state_avg
 from state_rank
 order by state_avg;

  --NTILE
 --Divide customers into four CLV quartiles.
 select customer,customer_lifetime_value,
 ntile(4) over(order by customer_lifetime_value desc) as clv_quartile
 from customer_insurance
 order by customer_lifetime_value desc;

 --Divide customers into five income groups.
  select customer,income,
 ntile(5) over(order by income desc) as income_group
 from customer_insurance
 order by income desc;

 --Divide customers into ten premium deciles.
 select customer,monthly_premium_auto,
 ntile(10) over(order by monthly_premium_auto desc) as premium_decile
 from customer_insurance
 order by monthly_premium_auto desc;

 
--lag()
--Compare each customer's CLV with the previous customer
SELECT customer,
       customer_lifetime_value,
       LAG(customer_lifetime_value) OVER (
           ORDER BY customer_lifetime_value DESC
       ) AS previous_clv
FROM customer_insurance

--Compare premium with the previous premium

select customer,
monthly_premium_auto,
lag(monthly_premium_auto)
over(order by monthly_premium_auto) 
as previous_premium
from customer_insurance;
ORDER BY customer_lifetime_value DESC;

--Calculate difference between consecutive claim amounts.
SELECT customer,
       total_claim_amount,
       LAG(total_claim_amount) OVER (
           ORDER BY total_claim_amount DESC
       ) AS previous_claim_amount,
       total_claim_amount -
       LAG(total_claim_amount) OVER (
           ORDER BY total_claim_amount DESC
       ) AS claim_difference
FROM customer_insurance
ORDER BY total_claim_amount DESC;



--LEAD()
--Compare each customer with the next customer.

select customer,customer_lifetime_value,
lead(customer_lifetime_value)over(order by customer_lifetime_value desc) as
next_clv
from customer_insurance
order by customer_lifetime_value desc;

--Calculate premium difference with the next record.

select customer,monthly_premium_auto,
lead(monthly_premium_auto)over(order by monthly_premium_auto desc) as next_record,
monthly_premium_auto - lead(monthly_premium_auto)over(order by monthly_premium_auto desc) as difference
from customer_insurance

--Find premium growth between adjacent customers.

SELECT customer,
       monthly_premium_auto,
       LEAD(monthly_premium_auto) OVER (
           ORDER BY monthly_premium_auto DESC
       ) AS next_premium,
       LEAD(monthly_premium_auto) OVER (
           ORDER BY monthly_premium_auto DESC
       ) - monthly_premium_auto AS premium_growth
FROM customer_insurance
ORDER BY monthly_premium_auto DESC;