--CASE STATEMENTS


--Categorize customers into High, Medium, and Low CLV.
select customer,customer_lifetime_value,
case
when customer_lifetime_value < 10000 then 'low_clv' 
when customer_lifetime_value  between 10000 and 40000 then 'medium clv'
else 'high_clv'
end as clv_division
from customer_insurance;

--Categorize customers into High, Medium, and Low Income.
select customer,income,
case
when income < 10000 then 'low_income' 
when income  between 10000 and 40000 then 'medium_ income'
else 'high_ income'
end as income_division
from customer_insurance
order by income desc;

--Categorize customers into High, Medium, and Low Claim Risk.

select customer,total_claim_amount,
case
when total_claim_amount < 100 then 'low_claim' 
when total_claim_amount  between 100 and 1500 then 'medium_ claim'
else 'high_ claim'
end as claim_division
from customer_insurance
order by total_claim_amount desc;

--Categorize premium into Bronze, Silver, Gold, and Platinum.
select max(monthly_premium_auto), min(monthly_premium_auto) from customer_insurance;

select customer,monthly_premium_auto,
case
when monthly_premium_auto < 50 then 'bronze' 
when monthly_premium_auto  between 50 and 150 then 'silver'
when monthly_premium_auto  between 151 and 200 then 'gold'
else 'platinum'
end as premium_division
from customer_insurance;

--Customer Segments
--Find High CLV & Low Claims customers.
select customer,
customer_lifetime_value,
total_claim_amount
from customer_insurance
where customer_lifetime_value > 40000
and total_claim_amount < 500;

--Find High Income & Low Premium customers.
select customer,
income,
monthly_premium_auto
from customer_insurance
where income > 40000
and monthly_premium_auto < 100;


--Find High Claims & Low Income customers.
select customer,
income,
total_claim_amount
from customer_insurance
where income < 10000
and total_claim_amount >  1500;


--Find Premium customers with low CLV.
select customer,
monthly_premium_auto,
customer_lifetime_value
from customer_insurance
where customer_lifetime_value < 10000
and monthly_premium_auto >  200;



--Find customers eligible for premium upgrades.
SELECT customer,
       customer_lifetime_value,
       monthly_premium_auto
FROM customer_insurance
WHERE customer_lifetime_value > 40000
  AND monthly_premium_auto < 150
ORDER BY customer_lifetime_value DESC;



--Find loyal customers based on CLV
SELECT customer,
       customer_lifetime_value
FROM customer_insurance
WHERE customer_lifetime_value > 40000
ORDER BY customer_lifetime_value DESC;


--Find customers requiring retention campaign 
SELECT customer,
       customer_lifetime_value,
       months_since_last_claim
FROM customer_insurance
WHERE customer_lifetime_value > 40000
  AND months_since_last_claim >= 12
ORDER BY customer_lifetime_value DESC;

--Find customers suitable for upselling
--Target high-value customers with relatively low premiums:

SELECT customer,
       customer_lifetime_value,
       monthly_premium_auto
       
FROM customer_insurance
WHERE customer_lifetime_value > 40000
  AND monthly_premium_auto < 120
  ORDER BY customer_lifetime_value DESC;


  --Find customers suitable for cross-selling
--A simple business rule is customers with high CLV who have relatively few policies:

SELECT customer,
       customer_lifetime_value,
       number_of_policies,
       policy_type
FROM customer_insurance
WHERE customer_lifetime_value > 40000
  AND number_of_policies <= 2
ORDER BY customer_lifetime_value DESC;

--Find inactive customers based on response
--Here, response = 'No' means they did not respond to the marketing offer:
SELECT customer,
       response,
       customer_lifetime_value,
       monthly_premium_auto
FROM customer_insurance
WHERE response = 'No'
ORDER BY customer_lifetime_value DESC;


-- QUARTILES
--Count customers in each CLV quartile
WITH clv_quartiles AS (
    SELECT customer,
           customer_lifetime_value,
           NTILE(4) OVER (
               ORDER BY customer_lifetime_value DESC
           ) AS clv_quartile
    FROM customer_insurance
)

SELECT clv_quartile,
       COUNT(*) AS total_customers
FROM clv_quartiles
GROUP BY clv_quartile
ORDER BY clv_quartile;

--Calculate average premium within each quartile
WITH clv_quartiles AS (
    SELECT customer,
           customer_lifetime_value,
           monthly_premium_auto,
           NTILE(4) OVER (
               ORDER BY customer_lifetime_value DESC
           ) AS clv_quartile
    FROM customer_insurance
)

SELECT clv_quartile,
       ROUND(AVG(monthly_premium_auto), 2) AS avg_premium
FROM clv_quartiles
GROUP BY clv_quartile
ORDER BY clv_quartile;

--Compare income across quartiles
WITH clv_quartiles AS (
    SELECT customer,
           customer_lifetime_value,
           income,
           NTILE(4) OVER (
               ORDER BY customer_lifetime_value DESC
           ) AS clv_quartile
    FROM customer_insurance
)

SELECT clv_quartile,
       ROUND(AVG(income), 2) AS avg_income,
       MIN(income) AS min_income,
       MAX(income) AS max_income
FROM clv_quartiles
GROUP BY clv_quartile
ORDER BY clv_quartile;


--identify most profitable quartile
WITH clv_quartiles AS (
    SELECT *,
           NTILE(4) OVER (
               ORDER BY customer_lifetime_value DESC
           ) AS clv_quartile
    FROM customer_insurance
)

SELECT clv_quartile,
       COUNT(*) AS customers,
       ROUND(AVG(customer_lifetime_value), 2) AS avg_clv,
       ROUND(AVG(monthly_premium_auto), 2) AS avg_premium,
       ROUND(AVG(total_claim_amount), 2) AS avg_claim,
       ROUND(AVG(income), 2) AS avg_income,
       ROUND(AVG(customer_lifetime_value - total_claim_amount), 2) AS avg_profit
FROM clv_quartiles
GROUP BY clv_quartile
ORDER BY clv_quartile;