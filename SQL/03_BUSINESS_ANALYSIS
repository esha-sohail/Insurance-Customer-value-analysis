
--03_ BUSINESS ANALYSIS
--Customer Analysis

--Total customers by state.
SELECT state,
count(*) as total_customers
from customer_insurance
group by state
order by total_customers desc;

--Total customers by policy type.
SELECT policy_type,
count(*) as total_customers
from customer_insurance
group by policy_type
order by total_customers desc;

--Total customers by policy category
SELECT policy,
count(*) as total_customers
from customer_insurance
group by policy
order by total_customers desc;


--Total customers by education.
SELECT education,
count(*) as total_customers
from customer_insurance
group by education
order by total_customers desc;


--Total customers by employment status.
SELECT employment_status,
count(*) as total_customers
from customer_insurance
group by employment_status
order by total_customers desc;

--Total customers by vehicle class
SELECT vehicle_class,
count(*) as total_customers
from customer_insurance
group by vehicle_class
order by total_customers desc;

--Total customers by vehicle size.
SELECT vehicle_size,
count(*) as total_customers
from customer_insurance
group by vehicle_size
order by total_customers desc;


--REVNUE ANALYSIS
--Total monthly premium revenue.
select sum(monthly_premium_auto) as total_revnue
from customer_insurance;

--Average monthly premium.
select avg(monthly_premium_auto) as avg_revnue
from customer_insurance;

--Maximum monthly premium
select max(monthly_premium_auto) as max_revnue
from customer_insurance;

--Minimum monthly premium.
select min(monthly_premium_auto) as min_revnue
from customer_insurance

--Total Customer Lifetime Value.
select sum(customer_lifetime_value) as total_clv
from customer_insurance;

--Average Customer Lifetime Value.
select avg(customer_lifetime_value) as avg_clv
from customer_insurance;

--Average CLV by state.
select state,
avg(customer_lifetime_value) as avg_clv
from customer_insurance
group by state
order by avg_clv desc;

--Average CLV by policy type.
select policy_type,
avg(customer_lifetime_value) as avg_clv
from customer_insurance
group by policy_type
order by avg_clv desc;



--Claims Analysis
--Total claim amount.
select sum(total_claim_amount) as total_claim
from customer_insurance;

--Average claim amount.
select avg(total_claim_amount) as total_claim
from customer_insurance;

--Highest claim amount.
select max(total_claim_amount) as total_claim
from customer_insurance;

--Lowest claim amount.
select min(total_claim_amount) as total_claim
from customer_insurance;

--Average claim amount by coverage.
select coverage,
avg(total_claim_amount) as total_claim
from customer_insurance
group by coverage
order by total_claim desc;


--Average claim amount by vehicle class.
select vehicle_class,
avg(total_claim_amount) as total_claim
from customer_insurance
group by vehicle_class
order by total_claim desc;



--Marketing Analysis
--Response rate by sales channel.
SELECT sales_channel,
       COUNT(*) AS total_customers,
       COUNT(*) FILTER (WHERE response = 'Yes') AS responded_customers,
       ROUND(
           COUNT(*) FILTER (WHERE response = 'Yes') * 100.0 / COUNT(*),
           2
       ) AS response_rate_percentage
FROM customer_insurance
GROUP BY sales_channel
ORDER BY response_rate_percentage DESC;

--Response rate by policy type.
SELECT policy_type,
       COUNT(*) AS total_customers,
       COUNT(*) FILTER (WHERE response = 'Yes') AS responded_customers,
       ROUND(
           COUNT(*) FILTER (WHERE response = 'Yes') * 100.0 / COUNT(*),
           2
       ) AS response_rate_percentage
FROM customer_insurance
GROUP BY policy_type
ORDER BY response_rate_percentage DESC;


--Average CLV of customers who accepted the offer.
SELECT ROUND(AVG(customer_lifetime_value), 2) AS avg_clv_accepted_offer
FROM customer_insurance
WHERE response = 'Yes';

--Compare income between responders and non-responders.
SELECT response,
       COUNT(*) AS total_customers,
       MIN(income) AS min_income,
       MAX(income) AS max_income,
       ROUND(AVG(income), 2) AS avg_income
FROM customer_insurance
GROUP BY response
ORDER BY avg_income DESC;
