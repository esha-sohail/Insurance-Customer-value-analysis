
--03_ BUSINESS ANALYSIS
--Customer Analysis

--Total customers by state.
SELECT state,
count(*) as total_customers
from customer_insurance
group by state
order by total_customers desc;

--Total customers by policy type.
SELECT policy_type,
count(*) as total_customers
from customer_insurance
group by policy_type
order by total_customers desc;

--Total customers by policy category
SELECT policy,
count(*) as total_customers
from customer_insurance
group by policy
order by total_customers desc;


--Total customers by education.
SELECT education,
count(*) as total_customers
from customer_insurance
group by education
order by total_customers desc;


--Total customers by employment status.
SELECT employment_status,
count(*) as total_customers
from customer_insurance
group by employment_status
order by total_customers desc;

--Total customers by vehicle class
SELECT vehicle_class,
count(*) as total_customers
from customer_insurance
group by vehicle_class
order by total_customers desc;

--Total customers by vehicle size.
SELECT vehicle_size,
count(*) as total_customers
from customer_insurance
group by vehicle_size
order by total_customers desc;


--REVNUE ANALYSIS
--Total monthly premium revenue.
select sum(monthly_premium_auto) as total_revnue
from customer_insurance;

--Average monthly premium.
select avg(monthly_premium_auto) as avg_revnue
from customer_insurance;

--Maximum monthly premium
select max(monthly_premium_auto) as max_revnue
from customer_insurance;

--Minimum monthly premium.
select min(monthly_premium_auto) as min_revnue
from customer_insurance

--Total Customer Lifetime Value.
select sum(customer_lifetime_value) as total_clv
from customer_insurance;

--Average Customer Lifetime Value.
select avg(customer_lifetime_value) as avg_clv
from customer_insurance;

--Average CLV by state.
select state,
avg(customer_lifetime_value) as avg_clv
from customer_insurance
group by state
order by avg_clv desc;

--Average CLV by policy type.
select policy_type,
avg(customer_lifetime_value) as avg_clv
from customer_insurance
group by policy_type
order by avg_clv desc;